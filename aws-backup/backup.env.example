# Copie este arquivo para backup.env e preencha com os dados da sua EC2 (AWS Academy)
# cp backup.env.example backup.env

# Usuário SSH da EC2 (Debian = admin | Ubuntu = ubuntu | Amazon Linux = ec2-user)
EC2_USER=admin

# IP público ou DNS da sua instância EC2 (lembre que muda ao reiniciar o Lab do AWS Academy)
EC2_HOST=

# Caminho da chave .pem baixada da AWS (rode: chmod 400 sua-chave.pem)
EC2_KEY=~/Downloads/labsuser.pem

# Pasta na EC2 onde o backup ficará salvo
EC2_BACKUP_DIR=/home/admin/backup-repositorio

# Pasta local onde o Spring Boot salva os PDFs
LOCAL_STORAGE_DIR=../storage

# Mantenha true para incluir o dump do banco MySQL/MariaDB junto aos PDFs
BACKUP_DB=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=repositorio_tcc
DB_USER=repositorio
DB_PASS=repositorio_dev
