# =====================================================================
# Servidor HTTP
# =====================================================================
SERVER_PORT=8080

# =====================================================================
# Banco de Dados MySQL (na própria EC2 ou AWS RDS)
# =====================================================================
# Se o MySQL rodar na própria EC2, mantenha DB_HOST=localhost e DB_USE_SSL=false
# Se usar AWS RDS, informe o endpoint do RDS e DB_USE_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=repositorio_tcc
DB_USERNAME=repositorio
# Valor compatível com docker-compose.yml; em produção na EC2/RDS troque por uma senha forte
DB_PASSWORD=repositorio_dev
DB_USE_SSL=false

# =====================================================================
# Armazenamento Local Estruturado no disco da EC2 (EBS)
# Estrutura gravada: {STORAGE_LOCAL_DIR}/trabalhos/{ano}/{cursoId}/{uuid}.pdf
# =====================================================================
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=/var/lib/repositorio-tcc/storage

# Limite de upload de PDFs
UPLOAD_MAX_FILE_SIZE=100MB
UPLOAD_MAX_REQUEST_SIZE=110MB

# =====================================================================
# Segurança (JWT e Administrador Inicial)
# =====================================================================
JWT_SECRET=troque-por-uma-chave-secreta-aleatoria-com-mais-de-32-caracteres
JWT_EXPIRATION_HOURS=24
APP_ADMIN_NOME=Administrador
APP_ADMIN_EMAIL=admin@repositorio.local
APP_ADMIN_PASSWORD=troque-esta-senha-admin

# =====================================================================
# Backup periódico na AWS EC2 (opcional - gerenciável via /backups)
# =====================================================================
BACKUP_ENABLED=false
BACKUP_INTERVAL_MINUTES=60
BACKUP_EC2_USER=admin
BACKUP_EC2_HOST=
BACKUP_EC2_KEY=
BACKUP_EC2_DIR=/home/admin/backup-repositorio
BACKUP_TIMEOUT_SECONDS=300
