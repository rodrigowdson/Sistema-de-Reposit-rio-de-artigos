# =====================================================================
# Configuração de Deploy na AWS EC2
# =====================================================================
# 1. Copie este arquivo para: ec2/deploy.env
# 2. Coloque o IP da sua EC2 em EC2_HOST
# 3. Coloque sua chave .pem dentro de ec2/chaves/ (ou informe o caminho em EC2_KEY)
# 4. Rode .\ec2\subir-ec2.bat (Windows) ou ./ec2/deploy-ec2.sh (Linux/Mac)
#
# ATENÇÃO: ec2/deploy.env e ec2/chaves/ estão no .gitignore e nunca vão para o Git.
# =====================================================================

# IP público ou DNS da instância EC2 (ex.: 54.210.123.45)
EC2_HOST=

# Usuário SSH da instância EC2:
#   Ubuntu        -> ubuntu
#   Debian        -> admin
#   Amazon Linux  -> ec2-user
EC2_USER=ubuntu

# Caminho da chave .pem (se deixar vazio, o script detecta automaticamente um .pem em ec2/chaves/)
EC2_KEY=

# Credenciais do administrador inicial do sistema (usadas no 1o acesso e no envio de livros)
APP_ADMIN_NOME=Administrador
APP_ADMIN_EMAIL=admin@repositorio.local
APP_ADMIN_PASSWORD=troque-esta-senha-admin

# Senha do banco MySQL na EC2 (criado automaticamente via Docker Compose)
DB_PASSWORD=repositorio_dev

# Diretório persistente na EC2 onde os PDFs ficam gravados
STORAGE_LOCAL_DIR=/var/lib/repositorio-tcc/storage

# Limite máximo de upload de cada PDF
UPLOAD_MAX_FILE_SIZE=100MB
UPLOAD_MAX_REQUEST_SIZE=110MB
